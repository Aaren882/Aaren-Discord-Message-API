<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeLib>Shared</NativeLib>
    <Platforms>x64</Platforms>
    <AssemblyName>$([System.String]::Copy('$(MSBuildProjectName)_x64').ToLower())</AssemblyName>
    <Version>26.2.5</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <StripSymbols>true</StripSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!-- Get OS Platform -->
    <IsWindows>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))</IsWindows>
    <IsLinux>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))</IsLinux>

    <!-- Define Platform constants -->
    <DefineConstants Condition="'$(IsWindows)' == 'true'">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(IsLinux)' == 'true'">$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <!-- Mapping for Linux -->
  <ItemGroup Condition="'$(IsLinux)' == 'true'">
    <LinkerArg Include="-Wl,--version-script=$(MSBuildProjectDirectory)/exports.map" />
  </ItemGroup>
  <PropertyGroup Condition="'$(IsLinux)' == 'true'">
    <LinkerFlavor>lld</LinkerFlavor>
  </PropertyGroup>

  <Target Name="PrintBuildDetails" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="====================================================" />
    <Message Importance="high" Text="[🔶 Assembly] Assembly Name: $(AssemblyName)" />
    <Message Importance="high" Text="[🏷️ Version] Build Version: $(Version)" />
    <Message Importance="high" Text="[🏠 Platform] $(Configuration) | $(Platforms)" />
    <Message Importance="high" Condition="'$(IsWindows)' == 'true'" Text="[🔧 Notice] Target Platform Detected: WINDOWS (__stdcall)" />
    <Message Importance="high" Condition="'$(IsLinux)' == 'true'" Text="[🔧 Notice] Target Platform Detected: LINUX (__cdecl)" />
    <Message Importance="high" Text="====================================================" />
  </Target>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExtensionComponents\ExtensionComponents.csproj" />
    <ProjectReference Include="..\Component.DiscordEntity\Component.DiscordEntity.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>
</Project>
