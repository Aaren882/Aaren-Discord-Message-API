      </PropertyGroup>

      <Message Importance="high" Text="[🔑 Signing] Certificate detected, signing the Native AOT native DLL..." />
      <Message Importance="high" Text="[🔑 Target] &quot;$(PublishDir)$(TargetName).dll&quot;" />

      <Exec Command="&quot;$(ActualSignTool)&quot; sign /f &quot;$(AbsolutePfxPath)&quot; /p &quot;$(PfxPassword)&quot; /fd SHA256 /tr http://timestamp.sectigo.com /td sha256 &quot;$(PublishDir)$(TargetName).dll&quot;" />
      <Exec Command="&quot;$(ActualSignTool)&quot; verify /pa &quot;$(PublishDir)$(TargetName).dll&quot;" ContinueOnError="true" />
