{
    "version": "2.0.0",
    "tasks": [
        {
          "label": "Build hemtt",
          "type": "shell",
          "command": "hemtt build",
          "problemMatcher": [],
          "group": {
            "kind": "build",
            "isDefault": true
          }
        },
        {
          "label": "Build Service extension",
          "command": "dotnet",
          "type": "process",
          "args": [
            "publish",
            "${workspaceFolder}/extension/DiscordMessageAPIService/DiscordMessageAPIService.csproj",
            "-c", "Release", //- Configuration
            "-r", "win-x64", //- RID
            "-o", ".", //- Output
            "--self-contained"
          ],
          "problemMatcher": "$msCompile"
        },
        {
          "label": "Build extension",
          "command": "dotnet",
          "type": "process",
          "args": [
            "publish",
            "${workspaceFolder}/extension/DiscordMessageAPI/DiscordMessageAPI.csproj",
            "-c", "Release", //- Configuration
            "-r", "win-x64", //- RID
            "-o", ".", //- Output
            "--self-contained"
          ],
          "problemMatcher": "$msCompile"
        }
    ]
}
